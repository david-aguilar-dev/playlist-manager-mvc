@model IEnumerable<ListaReproduccionMVC.Models.Playlist>

@{
    ViewBag.Title = "Mis Playlists";
}

<h2>Mis Playlists</h2>

<p>
    @Html.ActionLink("Crear nueva playlist", "Create")
</p>

<table class="table">
    <tr>
        <th>Nombre</th>
        <th>Descripción</th>
        <th>Acciones</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
            <td>
                @Html.ActionLink("Detalles", "Details", new { id = item.PlaylistId }) |
                @Html.ActionLink("Editar", "Edit", new { id = item.PlaylistId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.PlaylistId })
            </td>
        </tr>
    }

</table>